<?xml version="1.0" encoding="utf-8"?>
<com.grumm.litelauncher.SwipeUpLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:paddingTop="56dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/clock"
            style="@style/WallpaperText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textSize="72sp" />

        <TextView
            android:id="@+id/date"
            style="@style/WallpaperText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textSize="18sp" />

        <LinearLayout
            android:id="@+id/pinned"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center_horizontal"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/hint"
            style="@style/WallpaperText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:text="@string/home_hint"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>

    <ViewStub
        android:id="@+id/drawer_stub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout="@layout/view_drawer" />
</com.grumm.litelauncher.SwipeUpLayout>
